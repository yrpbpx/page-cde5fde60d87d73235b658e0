round:var(--amber-soft);padding:3px 10px;border-radius:2px}\n.plan .price{font-size:20px;font-weight:700;color:var(--deep-3);font-variant-numeric:tabular-nums}\n.plan .price small{font-size:12.5px;font-weight:400;color:var(--muted);letter-spacing:.04em;margin-left:4px}\n.plan .annual{font-size:13px;color:var(--muted);margin:0}\n.plan ul{margin:0;padding:0;list-style:none;display:grid;gap:9px}\n.plan ul li{padding-left:18px;position:relative;font-size:15px}\n.plan ul li::before{content:\"\";position:absolute;left:0;top:.72em;width:7px;height:1px;background:var(--amber)}\n.plan.lv1{margin-left:0}\n.plan.lv2{margin-left:0;background:rgba(224,161,58,.06)}\n.plan.lv3{margin-left:0}\n@media (min-width:800px){\n  .plan{grid-template-columns:minmax(210px,240px) 1fr;gap:10px 44px;align-items:start}\n  .plan .head{display:block}\n  .plan .head h3{margin-bottom:8px}\n  .plan .price{display:block;margin-bottom:2px}\n  .plan .annual{margin-bottom:0}\n  .plan.lv2{margin-left:34px}\n  .plan.lv3{margin-left:68px}\n}\n.plan-note{margin-top:30px;font-size:13.5px;color:var(--muted);max-width:46em}\n\n/* 客户端区块 */\n.clients{display:grid;gap:40px}\n.client h3{margin:0 0 8px;font-size:18px}\n.client .tag{display:inline-block;font-size:11.5px;letter-spacing:.16em;color:var(--muted);border:1px solid var(--line);padding:2px 9px;border-radius:2px;margin-bottom:12px}\n.client p{margin:0 0 12px}\n.client p:last-child{margin-bottom:0}\n@media (min-width:820px){\n  .clients{grid-template-columns:1fr 1fr;gap:48px 56px}\n}\n\n/* FAQ 按主题分组 */\n.faq-group{margin-bottom:48px}\n.faq-group:last-child{margin-bottom:0}\n.faq-group > h3{font-size:13px;letter-spacing:.24em;color:var(--amber);margin:0 0 8px;font-weight:600}\n.faq-group > .gtitle{font-size:19px;margin:0 0 22px;letter-spacing:.02em}\n.qa{border-top:1px solid var(--line);padding:20px 0}\n.qa:last-of-type{border-bottom:1px solid var(--line)}\n.qa dt{font-weight:600;font-size:16px;margin-bottom:8px}\n.qa dd{margin:0;color:#3c4b57;font-size:15px}\n.qa dl{margin:0}\n\n/* 页脚 */\nfooter{background:var(--deep);color:#9db6c8;padding:48px 0 54px;font-size:13.5px}\nfooter .fgrid{display:grid;gap:28px}\nfooter strong{color:#fff;letter-spacing:.1em;font-size:14px}\nfooter p{margin:8px 0 0;max-width:36em}\nfooter a{color:var(--amber-soft);border-bottom-color:rgba(240,198,126,.4)}\nfooter .fnav{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:4px}\nfooter .fnav a{border-bottom:none;color:#c3d6e4;font-size:13px}\nfooter .fnav a:hover{color:var(--amber-soft)}\nfooter .fine{margin-top:34px;padding-top:20px;border-top:1px solid rgba(255,255,255,.14);font-size:12.5px;color:#7e98ac}\n@media (min-width:760px){\n  footer .fgrid{grid-template-columns:1.4fr 1fr 1fr}\n}\n</style><div class=\"topbar\">\n  <div class=\"inner\">\n    <span class=\"brandmark\">牧牛<em>MUNIU</em></span>\n    <nav aria-label=\"页面目录\">\n      <a href=\"#intro\">方案说明</a>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#guide\">使用步骤</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <span class=\"kicker\">MUNIU · 方案说明</span>\n      <h1>牧牛(MUNIU) · 牧牛 MUNIU：把网络访问这件事，写成一份读得懂的说明书</h1>\n      <p class=\"lede\">这份页面不讲形容词。它按顺序交代清楚四件事：牧牛提供什么、各档套餐给多少额度、客户端怎么装、出问题时按什么顺序排查。<strong>你读完应该能自己判断要不要用、用哪一档。</strong></p>\n      <p class=\"lede\">全文按主题分节，每节都可单独阅读。如果你只想看价格，直接跳到套餐一节；如果你已经在用、只是碰到问题，常见问题一节按主题分组，找对应那一组即可。</p>\n\n      <div class=\"cols\">\n        <div class=\"col\">\n          <h3>关于这份说明</h3>\n          <p>页面上的套餐名称、流量额度、设备数量与年付口径，均以正文列出的内容为准。未在本页写明的规格，本文不作补充说明。</p>\n        </div>\n        <div class=\"col\">\n          <h3>阅读方式</h3>\n          <p>先读方案说明了解边界，再看套餐对照自己的用量，最后按客户端与使用步骤完成配置。遇到异常，从常见问题里找对应主题。</p>\n        </div>\n        <div class=\"col\">\n          <h3>写作原则</h3>\n          <p>能写清楚的写清楚，不能确认的不写。本页不对速度、线路质量、覆盖范围作任何未经列明的承诺。</p>\n        </div>\n      </div>\n\n      <p class=\"sig\">牧牛 MUNIU · 方案说明文档　版本以本页内容为准</p>\n    </div>\n  </header>\n\n  <section id=\"intro\">\n    <div class=\"narrow\">\n      <div class=\"sec-head\">\n        <span class=\"num\">01 / 方案说明</span>\n        <h2>牧牛提供的是一套按额度分档的网络访问方案</h2>\n        <p>定价结构简单：按月或按年付费，换取每月固定流量额度与固定数量的同时在线设备名额。三档之间的差别只在额度、设备数与附加能力，不涉及使用方式的变化。</p>\n      </div>\n\n      <div class=\"stack\">\n        <div class=\"block\">\n          <p class=\"meta\">计费单位</p>\n          <h3>按“每月流量 + 同时在线设备数”计量</h3>\n          <p>套餐的核心参数只有两个：每月可用流量，以及允许同时保持在线的设备数量。流量按月重置，设备数指同一时刻处于连接状态的终端上限，不是累计添加过的设备总数。</p>\n          <p>超出流量额度后的处理方式，本页不作额外承诺；如需了解，请以你实际购买时看到的条款为准。</p>\n        </div>\n\n        <div class=\"block\">\n          <p class=\"meta\">付费周期</p>\n          <h3>月付与年付并行，年付按十个月计</h3>\n          <p>三档套餐都提供月付与年付两种周期。年付价格是月付价格的十倍，相当于按十个月计费、覆盖十二个月。选择年付前，建议先按月付使用一段时间，确认额度与设备数适合自己的实际使用节奏。</p>\n        </div>\n\n        <div class=\"block\">\n          <p class=\"meta\">升级路径</p>\n          <h3>档位之间只上调额度，不改变操作方式</h3>\n          <p>基础版、旗舰版、团队版的客户端安装与配置流程完全一致，升级后无需重新学习使用方法。差异体现在流量上限、同时在线设备数量，以及团队版提供的企业定制路由与专属对接。</p>\n          <ul>\n            <li>只在一两台设备上使用、以浏览与影音为主：基础版的额度通常够用。</li>\n            <li>多设备并用、需要更宽裕的流量与更多同时在线名额：考虑旗舰版。</li>\n            <li>多人协作、需要统一配置与对接人：团队版更为合适。</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">02 / 套餐</span>\n        <h2>三档套餐，按额度逐级递进</h2>\n        <p>下列价格与权益为本页展示内容。三档均提供月付与年付，年付按十个月计费。</p>\n      </div>\n\n      <div class=\"plans\">\n\n        <article class=\"plan lv1\">\n          <div class=\"head\">\n            <h3>基础版</h3>\n            <span class=\"price\">¥15<small>/ 月</small></span>\n            <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n          </div>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan lv2\">\n          <div class=\"head\">\n            <h3>旗舰版</h3>\n            <span class=\"badge\">多数人选择</span>\n            <span class=\"price\">¥35<small>/ 月</small></span>\n            <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          </div>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan lv3\">\n          <div class=\"head\">\n            <h3>团队版</h3>\n            <span class=\"price\">¥85<small>/ 月</small></span>\n            <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"plan-note\">说明：本页仅列出套餐的名称、价格、计费周期与权益项。购买入口与支付方式不在本页提供，请以你实际下单时看到的页面为准。文中未写明的规格，本页不作补充。</p>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">03 / 客户端</span>\n        <h2>客户端按设备类型分开安装，三档共用同一套流程</h2>\n        <p>牧牛的配置方式是“获得连接信息 → 在对应客户端中导入 → 开启连接”。不同系统的操作路径略有差异，下面按平台分别说明。下载地址以你购买后获得的渠道为准，本页不提供下载链接。</p>\n      </div>\n\n      <div class=\"clients\">\n\n        <article class=\"client\">\n          <span class=\"tag\">桌面端</span>\n          <h3>Windows 与 macOS</h3>\n          <p>在桌面端安装客户端后，用购买时获得的连接信息完成导入，导入成功后列表里会出现可用的线路条目，选中并开启连接即可。</p>\n          <p>桌面端支持随系统启动与后台驻留，适合长期保持在线的使用方式。若一台电脑需要切换不同网络环境，建议为每个环境保留独立的配置条目，避免反复覆盖。</p>\n        </article>\n\n        <article class=\"client\">\n          <span class=\"tag\">移动端</span>\n          <h3>iOS 与 Android</h3>\n          <p>移动端在首次开启连接时需要授予系统级网络配置权限，这是系统层面的要求，与是否信任某款应用无关。授权后即可在应用内选择线路并开启。</p>\n          <p>移动设备切换 Wi-Fi 与蜂窝网络时可能短暂断开，属正常现象，重新连接即可。若长期不用，建议在应用内主动断开，避免后台占用同时在线名额。</p>\n        </article>\n\n        <article class=\"client\">\n          <span class=\"tag\">路由与共享</span>\n          <h3>在路由器上使用</h3>\n          <p>若希望整个局域网共用一条连接，可在支持相应功能的路由器上配置。此时所有接入该路由的设备会共用同一个出口，也会共同占用套餐的同时在线名额。</p>\n          <p>团队版的定制路由能力面向有统一出口需求的场景，具体配置项需要在开通后与对接人确认，本页不作展开。</p>\n        </article>\n\n        <article class=\"client\">\n          <span class=\"tag\">名额管理</span>\n          <h3>同时在线设备怎么算</h3>\n          <p>同时在线名额按“当前处于连接状态的设备”计数。同一台设备在多个客户端重复登录，可能被计为多个连接；退出登录或主动断开后，名额释放。</p>\n          <p>若出现名额已满的提示，先检查是否有旧设备仍在后台保持连接，而不是直接升级套餐。</p>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"num\">04 / 使用步骤</span>\n        <h2>从零开始，按四步完成配置</h2>\n        <p>以下顺序适用于三档套餐。如果中途出现问题，先回到上一步确认，再继续往下走。</p>\n      </div>\n\n      <div class=\"steps\">\n\n        <div class=\"step\">\n          <h3>确认档位与额度</h3>\n          <p>先估算自己每月的实际用量与常用设备数量，再对照套餐一节的三档参数选择。设备数按“同时在线”计算，不是按历史添加过的设备总数，这一点容易高估需求。</p>\n          <p>不确定时先选低一档，按月付观察一到两个计费周期，再决定是否调整。</p>\n        </div>\n\n        <div class=\"step\">\n          <h3>安装对应平台的客户端</h3>\n          <p>按你的设备类型选择桌面端或移动端客户端安装。安装来源以你购买后获得的渠道为准，不要从来源不明的页面获取安装包。</p>\n          <p>移动端首次连接会请求系统权限，这是正常流程；拒绝授权会导致连接无法建立。</p>\n        </div>\n\n        <div class=\"step\">\n          <h3>导入连接信息并保存</h3>\n          <p>用购买时获得的连接信息在客户端内完成导入。导入成功后，建议先保存为命名清晰的配置条目，便于日后在不同网络环境之间切换。</p>\n          <p>这些连接信息等同于凭证，不要转发给他人，也不要粘贴到公开页面。</p>\n        </div>\n\n        <div class=\"step\">\n          <h3>连接、验证、再使用</h3>\n          <p>选择线路并开启连接，随后打开一个常用页面确认访问正常，再开始正式使用。若无法访问，按常见问题一节的排查顺序逐项确认，不要同时改动多个设置。</p>\n          <p>日常使用中如遇明显变慢，可先切换线路再观察，避免误判为账号问题。</p>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <hr class=\"rule\">\n\n  <section id=\"faq\">\n    <div class=\"narrow\">\n      <div class=\"sec-head\">\n        <span class=\"num\">05 / 常见问题</span>\n        <h2>按主题分组的常见问题</h2>\n        <p>分为四组：计费与额度、设备与名额、安装与连接、支持与沟通。每组内的问题独立作答，不依赖前文。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>主题一</h3>\n        <p class=\"gtitle\">计费与额度</p>\n        <dl>\n          <div class=\"qa\">\n            <dt>年付和月付的差别只有价格吗？</dt>\n            <dd>在本页展示的内容范围内，年付与月付的权益项一致，区别在于计费周期与总价。年付金额为月付金额的十倍，覆盖十二个月，相当于按十个月计费。若你还不确定长期使用，建议先按月付。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>每月流量什么时候重置？</dt>\n            <dd>流量按月度周期计算并重置。具体的重置时点与你下单的时间相关，本页不额外规定。重置后未用完的部分不累积到下一周期。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>当月流量用完了会怎样？</dt>\n            <dd>本页不对超出额度后的处理方式作出承诺，以免与实际条款不一致。遇到这种情况，请以你购买时看到的条款为准，或在下单前的说明中确认清楚再决定档位。</dd>\n          </div>\n        </dl>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>主题二</h3>\n        <p class=\"gtitle\">设备与名额</p>\n        <dl>\n          <div class=\"qa\">\n            <dt>三档套餐分别能同时在线几台设备？</dt>\n            <dd>基础版 3 台、旗舰版 5 台、团队版 20 台。这里的数量指同一时刻处于连接状态的设备上限，不是累计可以添加的设备总数。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>同一台设备装了两个客户端，算几个名额？</dt>\n            <dd>通常按当前处于连接状态的连接数计算，因此同一台设备在两处同时保持连接可能被计为多个。日常使用中建议只保留一个客户端处于连接状态。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>提升设备数量只能换档吗？</dt>\n            <dd>在本页列出的三档方案中，同时在线名额与档位绑定，提高名额的方式是选择更高一档。是否支持其他调整方式，本页不作说明。</dd>\n          </div>\n        </dl>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>主题三</h3>\n        <p class=\"gtitle\">安装与连接</p>\n        <dl>\n          <div class=\"qa\">\n            <dt>连接不上，第一步该检查什么？</dt>\n            <dd>先确认导入的连接信息完整、未过期，再确认设备本身的网络是通的。这两项都正常后，再尝试更换线路。一次只改一个变量，便于判断真正的原因。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>移动端提示需要授予权限，可以拒绝吗？</dt>\n            <dd>可以拒绝，但连接将无法建立。该权限是系统层面的要求，用于把设备的网络流量交给客户端处理。授权后如不再使用，可在系统设置中撤销。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>为什么切换 Wi-Fi 后会短暂断开？</dt>\n            <dd>设备在网络之间切换时，连接需要重新建立，短暂中断属正常现象。等待重新连接完成即可，若长时间未恢复，可手动断开后再次连接。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>连接信息可以分享给同事吗？</dt>\n            <dd>不建议。连接信息等同于账号凭证，分享出去会让对方占用你的同时在线名额，也无法追溯使用情况。多人协作的场景应选择团队版并统一管理。</dd>\n          </div>\n        </dl>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>主题四</h3>\n        <p class=\"gtitle\">支持与沟通</p>\n        <dl>\n          <div class=\"qa\">\n            <dt>旗舰版的优先工单支持指什么？</dt>\n            <dd>按本页套餐所列内容，旗舰版包含 7×24 优先工单支持，即提交工单时可获得优先处理次序。具体的响应时限本页不作承诺，以免与实际执行不一致。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>团队版的专属客户经理负责哪些事？</dt>\n            <dd>按本页套餐所列内容，团队版提供专属客户经理，作为统一对接人。是否覆盖配置协助、额度规划等具体事项，需要在开通后与对接人确认，本页不作展开。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>提交问题时怎样描述更快被处理？</dt>\n            <dd>提供四类信息：使用的套餐、设备系统与客户端版本、问题出现的具体操作步骤、以及能否稳定复现。信息齐全的工单通常能省去一轮反问。</dd>\n          </div>\n        </dl>\n      </div>\n\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"fgrid\">\n      <div>\n        <strong>牧牛 MUNIU</strong>\n        <p>本页为方案说明文档，用于说明套餐构成、客户端安装与使用步骤。页面所列价格与权益以正文为准，未列明的规格不作补充。</p>\n      </div>\n      <div>\n        <strong>页面目录</strong>\n        <div class=\"fnav\">\n          <a href=\"#intro\">方案说明</a>\n          <a href=\"#plans\">套餐</a>\n          <a href=\"#clients\">客户端</a>\n          <a href=\"#guide\">使用步骤</a>\n          <a href=\"#faq\">常见问题</a>\n        </div>\n      </div>\n      <div>\n        <strong>阅读提示</strong>\n        <p>连接信息属于账号凭证，请勿转发或公开。跨设备使用时，先确认同时在线名额是否充足。</p>\n      </div>\n    </div>\n    <p class=\"fine\">牧牛 MUNIU · 方案说明　本页不提供下载链接、支付入口或外部跳转，相关事项以你实际下单与开通时看到的内容为准。</p>\n  </div>\n</footer>",
